# منع الوصول لملفات HTML القديمة غير المستخدمة
<FilesMatch "^(admin|admin1|admin11|admin111|financeadmin|financeadmin1|withdrawing-admin|withdrawing-admin11)\.html$">
    Require all denied
</FilesMatch>

AddType application/x-httpd-php .html .htm

# تفعيل mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# منع عرض قائمة الملفات
Options -Indexes

# تفعيل UTF-8
AddDefaultCharset UTF-8

# 🔹 كاش للـ Static Files (مهم لـ Cloudflare)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
</IfModule>

# 🔹 Headers للكاش
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

